# Build output (Maven)
target/

# Provisioned JavaFX runtime (created by setup-jre.sh, ~165 MB)
jre/

# Maven shade plugin byproduct
dependency-reduced-pom.xml

# Launcher runtime data/cache if created outside target/
data/
cache/

# Logback rolling log file (runtime artifact)
mirto-launcher.log*

# Windows release build outputs (assembled app, embedded JRE, installer)
build/windows/app/
build/windows/jre/
build/windows/output/

# Linux packages build outputs (deb/AppImage workdirs and artifacts)
build/linux/work/
build/linux/output/

# OS / editor cruft
.DS_Store
Thumbs.db
